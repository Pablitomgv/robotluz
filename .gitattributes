# Normalizar finales de línea a LF en el repo (Windows usa CRLF al hacer checkout)
* text=auto eol=lf

# Archivos binarios (no tocar)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.woff binary
*.woff2 binary
*.mp3  binary
*.ogg  binary

# Archivos que deben tener LF siempre
*.sh   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Lockfile de npm (no modificar)
package-lock.json  -diff